{
  "ws_host": "127.0.0.1",
  "ws_port": 7800,
  "sample_rate": 16000,

  "audio": {
    "_comment": "麦克风/扬声器设备(设备名子串或索引)；留空=系统默认。ElectronBot 板载 USB 麦克风插上后，用 `python sidecar.py --list-devices` 查到它的名字填这里。",
    "input_device": "",
    "output_device": ""
  },

  "asr": {
    "_comment": "离线 ASR：SenseVoice（中文效果好）。模型见 download_models 脚本。",
    "model": "models/sense-voice/model.onnx",
    "tokens": "models/sense-voice/tokens.txt",
    "use_itn": true
  },

  "vad": {
    "_comment": "Silero VAD：检测语音起止，驱动波形与分段。",
    "model": "models/silero_vad.onnx",
    "threshold": 0.5,
    "min_silence_duration": 0.5,
    "min_speech_duration": 0.25
  },

  "tts": {
    "_comment": "VITS / Piper 风格 TTS。默认 VITS-zh(fanchen-C)。换 Piper(huayan)时改为下面注释的那组并清空 lexicon/dict_dir。",
    "model": "models/vits-zh/model.onnx",
    "tokens": "models/vits-zh/tokens.txt",
    "lexicon": "models/vits-zh/lexicon.txt",
    "dict_dir": "models/vits-zh/dict",
    "data_dir": "",
    "_piper": { "model": "models/vits-piper/model.onnx", "tokens": "models/vits-piper/tokens.txt", "data_dir": "models/vits-piper/espeak-ng-data", "lexicon": "", "dict_dir": "" },
    "speaker_id": 0,
    "speed": 1.0
  },

  "wake": {
    "_comment": "唤醒词（可选）。enabled=false 时改为 VAD 触发的常听模式。",
    "enabled": false,
    "keywords_file": "models/kws/keywords.txt",
    "tokens": "models/kws/tokens.txt",
    "encoder": "models/kws/encoder.onnx",
    "decoder": "models/kws/decoder.onnx",
    "joiner": "models/kws/joiner.onnx"
  }
}
