# ===== Go =====
# 编译产物
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
# 测试与覆盖率
*.test
*.out
coverage.*
# Go 工作区
go.work
go.work.sum

# ===== 前端 (web/) =====
node_modules/
web/dist/
web/.vite/
*.local

# ===== sidecar (二进制/模型/用户配置不入库) =====
/sidecars/**/bin/
/sidecars/**/.venv/
/sidecars/speech/models/
/sidecars/speech/config.json
/sidecars/gesture/*.task
__pycache__/
*.onnx
*.bin
!**/.gitkeep

# ===== 运行期数据（用户配置/录制/表情素材，不入库） =====
/bin/
/config.json
/actions.json
/emotions/
# 运行/调试日志与临时音频
*.log
*.err
es.err.log
/sidecars/speech/_tts_test.wav
# 3D 源 CAD（大文件，运行时只用转换后的 .glb；如需重转见 docs）
/web/public/models/*.step

# ===== 编辑器 / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db
